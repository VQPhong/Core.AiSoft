@page "/knowledge/index-management"
@attribute [Authorize(KnowledgePermissions.IngestionJobs.Default)]
@using Core.AiSoft.Knowledge.Documents
@using Core.AiSoft.Knowledge.Permissions
@using Core.AiSoft.Knowledge.PostIndexing
@using Radzen
@using Radzen.Blazor
@using Volo.CmsKit.Admin.Blogs
@inherits AiSoftComponentBase

@* Hosts Radzen dialogs / notifications for this page. *@
<RadzenComponents />

<RadzenCard class="mb-3">
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="Radzen.JustifyContent.SpaceBetween" AlignItems="Radzen.AlignItems.Center">
        <RadzenText TextStyle="TextStyle.H5" class="m-0">@KL["IndexManagement"]</RadzenText>
        <RadzenButton Text="@KL["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="RefreshAsync" />
    </RadzenStack>
</RadzenCard>

<RadzenRow Gap="1rem">
    <RadzenColumn Size="12" SizeLG="4">
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6">@KL["Blogs"]</RadzenText>
            <RadzenDataGrid @ref="BlogGrid" TItem="BlogDto" Data="@Blogs" SelectionMode="Radzen.DataGridSelectionMode.Single"
                            @bind-Value="@SelectedBlogs" RowSelect="OnBlogSelectedAsync" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="BlogDto" Property="@nameof(BlogDto.Name)" Title="@KL["Name"]" />
                    <RadzenDataGridColumn TItem="BlogDto" Property="@nameof(BlogDto.BlogPostCount)" Title="@KL["PostCount"]" Width="90px" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeLG="8">
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6">@KL["Posts"] @(SelectedBlog == null ? "" : $"– {SelectedBlog.Name}")</RadzenText>

            @if (SelectedBlog == null)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="text-muted">@KL["SelectABlog"]</RadzenText>
            }
            else
            {
                @if (!IsKnowledgeBlog)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="false">@KL["NotIngestibleHint"]</RadzenAlert>
                }

                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="Radzen.AlignItems.Center" Gap="0.5rem" class="mb-2" Wrap="Radzen.FlexWrap.Wrap">
                    <RadzenTextBox @bind-Value="@Filter" Placeholder="@KL["Filter"]" Change="@(_ => ReloadPostsAsync(resetPage: true))" Style="min-width: 240px" />
                    @if (IsKnowledgeBlog && CanUpload)
                    {
                        @* Native file input styled as a button; the upload converts to Markdown and opens the CMS Kit editor. *@
                        <label class="rz-button rz-button-md rz-variant-filled rz-primary rz-shade-default mb-0 @(IsUploading ? "rz-state-disabled" : "")">
                            <span class="rz-button-box">
                                <i class="rz-button-icon-left rzi">upload</i>
                                <span class="rz-button-text">@(IsUploading ? KL["Uploading"] : KL["Upload"])</span>
                            </span>
                            <InputFile OnChange="UploadAsync" accept="@KnowledgeDocumentConsts.AllowedExtensionsForUpload" class="d-none" disabled="@IsUploading" />
                        </label>
                        <small class="text-muted">@KL["UploadHint"]</small>
                    }
                </RadzenStack>

                <RadzenDataGrid @ref="PostGrid" TItem="KnowledgePostDto" Data="@Posts" Count="@PostTotalCount" LoadData="LoadPostsAsync"
                                IsLoading="@IsLoadingPosts" AllowPaging="true" PageSize="@PageSize" PagerHorizontalAlign="HorizontalAlign.Left"
                                AllowSorting="false" Density="Density.Compact" EmptyText="-">
                    <Columns>
                        <RadzenDataGridColumn TItem="KnowledgePostDto" Property="@nameof(KnowledgePostDto.Title)" Title="@KL["Title"]">
                            <Template Context="post">
                                @post.Title
                                @if (!post.IsPublished)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@KL["Draft"]" class="ms-1" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="KnowledgePostDto" Property="@nameof(KnowledgePostDto.Version)" Title="@KL["Version"]" Width="90px" />
                        <RadzenDataGridColumn TItem="KnowledgePostDto" Property="@nameof(KnowledgePostDto.IndexStatus)" Title="@KL["IndexStatus"]" Width="170px">
                            <Template Context="post">
                                <RadzenBadge BadgeStyle="@StatusStyle(post.IndexStatus)" Text="@KL[$"Enum:PostIndexStatus.{post.IndexStatus}"]" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="KnowledgePostDto" Property="@nameof(KnowledgePostDto.IndexedVersion)" Title="@KL["IndexedVersion"]" Width="120px" />
                        <RadzenDataGridColumn TItem="KnowledgePostDto" Property="@nameof(KnowledgePostDto.IndexedAt)" Title="@KL["IndexedAt"]" FormatString="{0:g}" Width="150px" />
                        <RadzenDataGridColumn TItem="KnowledgePostDto" Property="@nameof(KnowledgePostDto.ChunkCount)" Title="@KL["Chunks"]" Width="80px" />
                        <RadzenDataGridColumn TItem="KnowledgePostDto" Title="@KL["Actions"]" Width="360px" Sortable="false">
                            <Template Context="post">
                                <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.25rem" Wrap="Radzen.FlexWrap.Wrap">
                                    @if (CanPublish && !post.IsPublished)
                                    {
                                        <RadzenButton Text="@KL["Publish"]" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Success" Click="@(() => PublishAsync(post))" />
                                    }
                                    @if (CanCreateJob)
                                    {
                                        <RadzenButton Text="@KL["Index"]" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Primary"
                                                      Disabled="@(!post.IsIngestible || post.IndexStatus is PostIndexStatus.Running or PostIndexStatus.UpToDate)"
                                                      Click="@(() => CreateJobAsync(post, false))" />
                                    }
                                    @if (CanForce)
                                    {
                                        <RadzenButton Text="@KL["ForceIndex"]" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Warning"
                                                      Disabled="@(!post.IsIngestible || post.IndexStatus == PostIndexStatus.Running)"
                                                      Click="@(() => CreateJobAsync(post, true))" />
                                    }
                                    <RadzenButton Text="@KL["History"]" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => OpenHistoryAsync(post))" />
                                    <RadzenButton Text="@KL["Edit"]" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => OpenEditor(post))" />
                                    <RadzenButton Text="@KL["View"]" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Disabled="@(!post.IsPublished)" Click="@(() => OpenViewer(post))" />
                                    @if (CanDelete && IsKnowledgeBlog)
                                    {
                                        <RadzenButton Text="@KL["Delete"]" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger"
                                                      Disabled="@(post.IndexStatus == PostIndexStatus.Running)" Click="@(() => DeleteAsync(post))" />
                                    }
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
